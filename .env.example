# MongoDB connection URI — points to the local Docker container by default
MONGODB_URI=mongodb://localhost:27017/botfunnel

# Redis connection URL — points to the local Docker container by default
REDIS_URL=redis://localhost:6379

# Session TTL
SESSION_TTL_DEFAULT_HOURS=24
SESSION_TTL_REMEMBER_ME_DAYS=30

# Session cookie security (set true/strict in production)
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax

# Super Admin (seeded on first startup)
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=<replace-with-strong-password>

# Mail (Mailpit for local dev)
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@botfunnel.local
SUPPORT_EMAIL=support@botfunnel.local

# Application base URL (used in emails)
APP_URL=http://localhost:3000

# Maximum active projects per user (hard cap, service-enforced)
PROJECTS_MAX_PER_USER=5

# Bot module
# 32 bytes / 64 hex chars; generate with `openssl rand -hex 32`. NEVER commit a real value.
BOT_TOKEN_ENCRYPTION_KEY=
# HMAC-SHA256 key for signed subscriber-export download URLs.
# 32 bytes / 64 hex chars; generate with `openssl rand -hex 32`. NEVER commit a real value.
SUBSCRIBER_EXPORT_TOKEN_KEY=
# Max new /start subscribers per project per minute (Decision 9)
SUBSCRIBER_RATE_LIMIT_START_PER_MIN=100
# Days a DONE export's GridFS file is retained before the nightly cleanup job purges it (Decision 8, AC20)
SUBSCRIBER_EXPORT_RETENTION_DAYS=7
# Max signed-URL downloads per project per minute; fail-open on Redis outage (Decision 9)
SUBSCRIBER_DOWNLOAD_RATE_LIMIT_PER_MIN=30
# Signed download-URL lifetime in hours; 24h caps the link-leak window (Decision 15, security F2)
SUBSCRIBER_EXPORT_URL_TTL_HOURS=24
# Max personal messages per project per minute; fail-open on Redis outage (Decision 9, security F5)
SUBSCRIBER_PERSONAL_MESSAGE_RATE_LIMIT_PER_MIN=60
# Telegram Bot API base URL (defaults to https://api.telegram.org; override for staging-against-mock).
TELEGRAM_BASE_URL=
