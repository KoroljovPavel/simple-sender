  +                if (index != null && index >= 0 && index < snapshot.size()) {
  +                    String stepId = snapshot.get(index).getString("id");
  +                    if (stepId != null) {
  +                        set.append("currentStepId", stepId);
  +                    }
  +                }
  +            }
  +            if (!set.isEmpty()) {
