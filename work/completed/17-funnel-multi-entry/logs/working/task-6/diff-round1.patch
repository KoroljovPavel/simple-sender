  +const duplicateIndices = computed(() => {
  +  const seen = new Set<string>()
  +  const dups = new Set<number>()
  +  for (const { tr, index } of eventEntries.value) {
  +    const key = (tr.triggerValue ?? '').trim()
  +    if (!key) continue
  +    if (seen.has(key)) dups.add(index)
  +    else seen.add(key)
  +  }
  +  return dups
  +})
